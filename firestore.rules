rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo se puede leer o escribir dentro de un viaje conociendo su código.
    // No se puede listar qué viajes existen.
    match /trips/{tripId}/{document=**} {
      allow read, write: if tripId.size() >= 16;
    }
  }
}
